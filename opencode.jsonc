{
  "$schema": "https://opencode.ai/config.json",
  "model": "nim-proxy/z-ai/glm-5.1",
  "provider": {
    "nim-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NIM Local Proxy",
      "options": {
        "baseURL": "http://192.168.3.5:11431/v1"
      },
